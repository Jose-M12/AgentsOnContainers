{
  "name": "fedora-min-perf-claude-codex",
  "image": "quay.io/fedora/fedora-minimal:42",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "runArgs": [
    "--userns=keep-id",
    "--security-opt=label=disable",
    "--security-opt=no-new-privileges",
    "--shm-size=2g",
    "--cpus=14",
    "--memory=24g",
    "--pids-limit=4096"
  ],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,Z",
    "source=dnf-cache,target=/var/cache/dnf,type=volume",
    "source=npm-cache,target=/root/.npm,type=volume",
    "source=pip-cache,target=/root/.cache/pip,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": []
    }
  },
  "postCreateCommand": "microdnf -y update && microdnf -y install git curl tar gzip which procps-ng python3 python3-pip nodejs npm && microdnf clean all"
}