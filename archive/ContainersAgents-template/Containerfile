FROM docker.io/library/node:24-bookworm-slim

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        file \
        git \
        jq \
        less \
        openssh-client \
        procps \
        python3 \
        python3-pip \
        python3-venv \
        ripgrep \
        tini \
    && rm -rf /var/lib/apt/lists/*

# The official Node image already contains a non-root "node" user. Match it
# to the host UID/GID so bind-mounted project files keep normal ownership.
RUN if [ "$(id -g node)" != "$GROUP_ID" ]; then groupmod --gid "$GROUP_ID" node; fi \
    && if [ "$(id -u node)" != "$USER_ID" ]; then usermod --uid "$USER_ID" --gid "$GROUP_ID" node; fi \
    && mkdir -p /workspace /home/node/.local/bin /home/node/.npm-global \
    && chown -R "$USER_ID:$GROUP_ID" /workspace /home/node

ENV HOME=/home/node
ENV PATH=/home/node/.local/bin:/home/node/.npm-global/bin:${PATH}
ENV NPM_CONFIG_PREFIX=/home/node/.npm-global

USER node
WORKDIR /workspace

# Agent CLIs should be installed here later, once their exact official
# package names and versions are selected. Runtime sessions never apt-upgrade.
CMD ["sleep", "infinity"]
