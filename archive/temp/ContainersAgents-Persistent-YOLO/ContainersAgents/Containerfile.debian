FROM docker.io/library/node:24-trixie-slim

ARG USER_ID=1000
ARG GROUP_ID=1000
ARG INSTALL_AGENT_CLIS=1
ARG CODEX_VERSION=latest
ARG CLAUDE_CODE_CHANNEL=stable
ARG CLAUDE_CODE_KEY_FINGERPRINT=31DDDE24DDFAB679F42D7BD2BAA929FF1A7ECACE
ARG DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash build-essential ca-certificates curl file git git-lfs gpg jq less \
      openssh-client pkg-config procps python3 python3-pip python3-venv \
      ripgrep rsync sudo unzip xz-utils zip; \
    rm -rf /var/lib/apt/lists/*

# Install executable agent tools in image-managed system paths. Authentication,
# settings, histories, and caches are created later in the mounted /home/node.
RUN set -eux; \
    if [ "$INSTALL_AGENT_CLIS" = '1' ]; then \
      npm install --global --omit=dev "@openai/codex@${CODEX_VERSION}"; \
      install -d -m 0755 /etc/apt/keyrings; \
      curl -fsSL https://downloads.claude.ai/keys/claude-code.asc \
        -o /etc/apt/keyrings/claude-code.asc; \
      actual_fingerprint="$(gpg --show-keys --with-colons /etc/apt/keyrings/claude-code.asc \
        | awk -F: '$1 == "fpr" { print $10; exit }')"; \
      test "$actual_fingerprint" = "$CLAUDE_CODE_KEY_FINGERPRINT"; \
      echo "deb [signed-by=/etc/apt/keyrings/claude-code.asc] https://downloads.claude.ai/claude-code/apt/${CLAUDE_CODE_CHANNEL} ${CLAUDE_CODE_CHANNEL} main" \
        > /etc/apt/sources.list.d/claude-code.list; \
      apt-get update; \
      apt-get install -y --no-install-recommends claude-code; \
      rm -rf /var/lib/apt/lists/*; \
      npm cache clean --force; \
    fi

# Match the image's node account to the host UID/GID for normal ownership on
# bind-mounted project files.
RUN set -eux; \
    if [ "$(id -g node)" != "$GROUP_ID" ]; then groupmod --gid "$GROUP_ID" node; fi; \
    if [ "$(id -u node)" != "$USER_ID" ]; then usermod --uid "$USER_ID" --gid "$GROUP_ID" node; fi; \
    mkdir -p /workspace /home/node/.local/bin /home/node/.npm-global; \
    chown -R "$USER_ID:$GROUP_ID" /workspace /home/node; \
    printf 'node ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/90-containers-agents-node; \
    chmod 0440 /etc/sudoers.d/90-containers-agents-node

COPY extras/install-debian.sh /tmp/containers-agents-install-extra.sh
RUN chmod 0755 /tmp/containers-agents-install-extra.sh \
    && /tmp/containers-agents-install-extra.sh \
    && rm -f /tmp/containers-agents-install-extra.sh

LABEL io.jose.containers-agents.image-profile="debian-persistent-yolo" \
      io.jose.containers-agents.base="node:24-trixie-slim"

ENV HOME=/home/node
ENV PATH=/home/node/.local/bin:/home/node/.npm-global/bin:${PATH}
ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV DISABLE_AUTOUPDATER=1

USER node
WORKDIR /workspace
CMD ["sleep", "infinity"]
